{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedEffect": {
      "type": "string"
    },
    "measuredOutcome": {
      "type": "string"
    },
    "nextMeasure": {
      "type": "string"
    },
    "activate": {
      "type": "boolean"
    },
    "backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "priority": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "effortPoints": {
            "type": "integer"
          },
          "nextStep": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "research",
              "gameplay"
            ]
          },
          "acceptance": {
            "type": "string"
          },
          "requiredPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "priority",
          "title",
          "effortPoints",
          "nextStep",
          "id",
          "delivery",
          "acceptance",
          "requiredPaths"
        ]
      }
    },
    "taskId": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "implementation",
        "experiment",
        "instrumentation",
        "blocked",
        "no-change"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
