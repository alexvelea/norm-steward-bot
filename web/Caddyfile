alex.norn-steward.velea.cc {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' ws: wss:; img-src 'self' data:"
	}
	@game path /api/v1 /api/v1/* /mcp /mcp/*
	handle @game {
		reverse_proxy https://norn-steward.velea.cc {
			header_up Host norn-steward.velea.cc
		}
	}
	handle {
		root * /srv/norn-steward-ui
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
	}
}
